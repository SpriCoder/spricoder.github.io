---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div>
        <a class="footer-brand" href="/">SpriCoder<span>.</span></a>
        <p class="footer-note">持续记录，让知识与思考有所归处。</p>
      </div>
      <nav class="footer-links" aria-label="页脚导航">
        <a href="/atom.xml">RSS 订阅 <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/SpriCoder" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="/about/">关于我</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <div class="footer-copyright">© {year} SpriCoder <span class="footer-divider" aria-hidden="true">/</span> Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a></div>
      <div class="site-statistics" aria-label="网站访问统计">
        <span id="leancloud-site-pv-container">访问 <span id="leancloud-site-pv">—</span> 次</span>
        <span class="statistics-divider" aria-hidden="true">·</span>
        <span id="leancloud-site-uv-container">访客 <span id="leancloud-site-uv">—</span> 人</span>
      </div>
    </div>
    <div class="site-duration" aria-label="建站时长"><span id="timeDate">本站已运行</span> <span id="times">正在计算…</span></div>
  </div>
</footer>
