---
import { archivePageUrl } from '../lib/posts';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;
const visiblePages = [...new Set([
  1,
  totalPages,
  currentPage - 2,
  currentPage - 1,
  currentPage,
  currentPage + 1,
  currentPage + 2,
].filter(page => page >= 1 && page <= totalPages))].sort((a, b) => a - b);

const pageItems: (number | 'ellipsis')[] = [];
visiblePages.forEach((page, index) => {
  if (index > 0) {
    const previous = visiblePages[index - 1];
    if (page - previous === 2) pageItems.push(previous + 1);
    else if (page - previous > 2) pageItems.push('ellipsis');
  }
  pageItems.push(page);
});
---

{totalPages > 1 && (
  <nav class="archive-pagination" aria-label="归档分页">
    {currentPage > 1 ? (
      <a class="pagination-control" href={archivePageUrl(baseUrl, currentPage - 1)} rel="prev">上一页</a>
    ) : (
      <span class="pagination-control pagination-disabled" aria-disabled="true">上一页</span>
    )}
    {pageItems.map(page => page === 'ellipsis' ? (
      <span class="pagination-ellipsis" aria-hidden="true">…</span>
    ) : page === currentPage ? (
      <span class="pagination-number pagination-current" aria-current="page" aria-label={`第 ${page} 页，当前页`}>{page}</span>
    ) : (
      <a class="pagination-number" href={archivePageUrl(baseUrl, page)} aria-label={`第 ${page} 页`}>{page}</a>
    ))}
    {currentPage < totalPages ? (
      <a class="pagination-control" href={archivePageUrl(baseUrl, currentPage + 1)} rel="next">下一页</a>
    ) : (
      <span class="pagination-control pagination-disabled" aria-disabled="true">下一页</span>
    )}
  </nav>
)}

<style>
  .archive-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem 0;
  }

  .pagination-control,
  .pagination-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 40px;
    min-height: 40px;
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: var(--surface);
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }

  a.pagination-control:hover,
  a.pagination-number:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  a.pagination-control:focus-visible,
  a.pagination-number:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pagination-current {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--surface);
    font-weight: 700;
  }

  .pagination-disabled {
    opacity: 0.45;
  }

  .pagination-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 40px;
    color: var(--text);
    font-size: 15px;
  }
</style>
