---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allPosts, seriesSlug } from '../../lib/posts';
import courses from '../../data/courses.json';
const posts = await allPosts();
const series = [...new Set(posts.map(post => post.series).filter(Boolean))] as string[];
const domains = [...new Set(courses.map(course => course.domain))];
const courseCounts = new Map(courses.map(course => [course.slug, posts.filter(post => post.course === course.slug).length]));
const descriptions: Record<string, string> = {
  '与 AI 一起工作': 'AI 工具、Agent 协作、评测与科研实践。',
  '玩转时序数据集': 'TsFile、IoTDB、数据访问与常用工具。',
  '基准测试方法与实践': '工作负载设计、测试工具与性能结果分析。',
};
const topics = [
  ...series.map((name, index) => ({
    name,
    description: descriptions[name],
    url: `/series/${seriesSlug(name)}/`,
    count: posts.filter(post => post.series === name).length,
    anchor: index === 0 ? 'technical-series' : undefined,
  })),
  ...domains.flatMap(domain => courses.filter(course => course.domain === domain)).map((course, index) => ({
    name: course.name,
    description: course.description,
    url: `/courses/${course.slug}/`,
    count: courseCounts.get(course.slug),
    anchor: index === 0 ? 'course-collections' : undefined,
  })),
];
---
<SiteLayout title="专题" description="数据库、AI 协作与基准测试的技术系列，以及计算机和软件工程课程笔记。">
  <div class="container">
    <header class="page-header"><h1>专题</h1><p>{topics.length} 个专题</p></header>
    <ul class="course-directory-list" aria-label="全部专题">{topics.map(topic => <li id={topic.anchor}><a class="course-directory-link" href={topic.url}><span class="course-directory-main"><span class="course-directory-title">{topic.name}</span><span class="course-directory-description">{topic.description}</span></span><span class="course-directory-meta"><span>{topic.count} 篇</span><span aria-hidden="true">→</span></span></a></li>)}</ul>
  </div>
</SiteLayout>
