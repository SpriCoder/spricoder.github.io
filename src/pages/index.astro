---
import SiteLayout from '../layouts/SiteLayout.astro';
import PostCard from '../components/PostCard.astro';
import HomeCover from '../components/HomeCover.astro';
import { allPosts, seriesSlug } from '../lib/posts';
import courses from '../data/courses.json';
const posts = await allPosts();
const series = [...new Set(posts.map(post => post.series).filter(Boolean))] as string[];
const representativeDirectories = [
  '2020-Fundamentals-of-Data-Management',
  '2020-OS',
  '2020-Internet-computing',
  '2020-Compilation-Principle',
  '2020-Software-Engineering-and-Computing-II',
  '2019-Data-Structure',
];
const featuredCourses = representativeDirectories.flatMap(directory => {
  const course = courses.find(course => course.sourceDirectory === directory);
  return course ? [course] : [];
});
const descriptions: Record<string, string> = {
  '与 AI 一起工作': 'AI 工具、Agent 协作、评测与科研实践。',
  '玩转时序数据集': 'TsFile、IoTDB、数据访问与常用工具。',
  '基准测试方法与实践': '工作负载设计、测试工具与性能结果分析。',
};
---
<SiteLayout home>
  <HomeCover />
  <div class="container home-content" id="home-content" tabindex="-1">
    <section class="home-intro">
      <h1>SpriCoder 的博客</h1>
      <p>这里记录我在数据库、时序数据和 AI 工具方面的学习与实践。</p>
    </section>
    <section class="home-section" aria-labelledby="technical-series">
      <div class="section-heading"><h2 id="technical-series">技术系列</h2><a class="text-link" href="/series/">全部专题</a></div>
      <div class="series-grid">{series.map(name => <a class="series-card" href={`/series/${seriesSlug(name)}/`}><h3>{name}</h3><p>{descriptions[name]}</p><span class="series-card-meta">{posts.filter(post => post.series === name).length} 篇文章</span></a>)}</div>
    </section>
    <nav class="home-courses" aria-label="课程笔记">
      <span class="home-courses-label">课程笔记</span>
      {featuredCourses.map(course => <a href={`/courses/${course.slug}/`}>{course.name.replace(/\s*（\d{4}）$/, '')}</a>)}
      <a class="home-courses-all" href="/series/#course-collections">全部课程 →</a>
    </nav>
    <section class="home-section" aria-labelledby="latest-posts">
      <div class="section-heading"><h2 id="latest-posts">最新文章</h2><a class="text-link" href="/archives/">全部文章</a></div>
      <div class="post-list">{posts.slice(0, 10).map(post => <PostCard post={post} />)}</div>
    </section>
  </div>
</SiteLayout>
