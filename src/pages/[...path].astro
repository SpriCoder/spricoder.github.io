---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArchivePagination from '../components/ArchivePagination.astro';
import { allPosts, dateLabel, seriesSlug, taxonomyUrl, courseOrder, ARCHIVE_PAGE_SIZE, archivePageUrl } from '../lib/posts';
import legacyRoutes from '../../migration/legacy-routes.json';
import baseline from '../../migration/baseline.json';
export async function getStaticPaths() {
  const posts = await allPosts();
  const paths = posts.map(post => ({ params: { path: post.url.replace(/^\/+|\/+$/g, '') }, props: { post, posts } }));
  const occupied = new Set(posts.map(post => post.url));
  for (const listing of legacyRoutes) {
    if (listing.kind === 'links' || listing.kind === 'archives') continue;
    if (!occupied.has(listing.url)) paths.push({ params: { path: listing.url.replace(/^\/+|\/+$/g, '') }, props: { listing, posts } });
  }
  for (const kind of ['tags', 'categories']) {
    if (!legacyRoutes.some(route => route.url === `/${kind}/`)) paths.push({ params: { path: kind }, props: { listing: { url: `/${kind}/`, kind, title: kind === 'tags' ? '标签' : '分类' }, posts } });
  }
  const existing = new Set(paths.map(item => item.params.path));
  for (const kind of ['tags', 'categories'] as const) {
    const labels = [...new Set(posts.flatMap(post => post[kind]))];
    for (const name of labels) {
      const url = taxonomyUrl(kind, name);
      const route = url.replace(/^\/+|\/+$/g, '');
      if (!existing.has(route)) {
        paths.push({ params: { path: route }, props: { listing: { url, kind, title: `${kind === 'tags' ? '标签' : '分类'} - ${name}` }, posts } });
        existing.add(route);
      }
    }
  }
  const archiveGroups = new Map([['/archives/', posts]]);
  for (const post of posts) {
    const date = dateLabel(post.date);
    for (const prefix of [date.slice(0, 4), date.slice(0, 7).replace('-', '/')]) {
      const baseUrl = `/archives/${prefix}/`;
      if (!archiveGroups.has(baseUrl)) archiveGroups.set(baseUrl, []);
      archiveGroups.get(baseUrl).push(post);
    }
  }
  for (const [baseUrl, members] of archiveGroups) {
    const totalPages = Math.max(1, Math.ceil(members.length / ARCHIVE_PAGE_SIZE));
    const period = baseUrl.replace(/^\/archives\//, '').replace(/\/$/, '').replace('/', '-');
    for (let page = 1; page <= totalPages; page++) {
      const url = archivePageUrl(baseUrl, page);
      const route = url.replace(/^\/+|\/+$/g, '');
      if (!existing.has(route)) {
        paths.push({ params: { path: route }, props: {
          listing: { url, kind: 'archives', title: period ? `${period} · 文章归档` : '归档' },
          posts,
          archive: { baseUrl, currentPage: page, totalPages, totalItems: members.length, items: members.slice((page - 1) * ARCHIVE_PAGE_SIZE, page * ARCHIVE_PAGE_SIZE) },
        } });
        existing.add(route);
      }
    }
  }
  return paths;
}
const { post, listing, posts, archive } = Astro.props;
let selected = archive?.items ?? posts;
let listingTitle = listing?.title;
if (listing?.kind === 'tags' || listing?.kind === 'categories') {
  const prefix = listing.kind === 'tags' ? '标签' : '分类';
  const name = listing.title.replace(new RegExp(`^${prefix}\\s*[-—|]\\s*`), '');
  if (listing.url !== `/${listing.kind}/`) {
    selected = posts.filter(item => item[listing.kind].includes(name));
    if (listing.kind === 'tags' && selected.length === 0) {
      const oldMembers = new Set(baseline.filter(item => item.tags.includes(name)).map(item => item.id));
      selected = posts.filter(item => oldMembers.has(item.id));
    }
  }
}
const pageTitle = archive?.currentPage > 1 ? `${listingTitle} · 第 ${archive.currentPage} 页` : listingTitle;
const taxonomy = listing?.url === '/tags/' ? 'tags' : listing?.url === '/categories/' ? 'categories' : null;
const labels = taxonomy ? [...new Set(posts.flatMap(item => item[taxonomy]))].sort((a,b)=>a.localeCompare(b,'zh-CN')) : [];
const inSeries = post?.series ? posts.filter(item => item.series === post.series).sort((a,b)=>(a.series_order??999)-(b.series_order??999)||a.title.localeCompare(b.title,'zh-CN')) : [];
const seriesIndex = post ? inSeries.findIndex(item => item.url === post.url) : -1;
const previous = seriesIndex > 0 ? inSeries[seriesIndex - 1] : null;
const next = seriesIndex >= 0 ? inSeries[seriesIndex + 1] : null;
const coursePosts = post?.course ? posts.filter(item => item.course === post.course).sort(courseOrder) : [];
const courseIndex = post ? coursePosts.findIndex(item => item.url === post.url) : -1;
const previousCoursePost = courseIndex > 0 ? coursePosts[courseIndex - 1] : null;
const nextCoursePost = courseIndex >= 0 ? coursePosts[courseIndex + 1] : null;
---
<SiteLayout title={post?.title || pageTitle} description={post?.description || 'SpriCoder 的文章归档与分类。'} article={Boolean(post)}>
  {post ? <div class="container article-container">
    <header class="article-header"><a class="breadcrumb" href={post.course ? `/courses/${post.course}/` : post.series ? `/series/${seriesSlug(post.series)}/` : '/archives/'}>← {post.courseName || post.series || '文章归档'}</a><h1>{post.title}</h1><div class="article-meta"><time datetime={post.date}>{dateLabel(post.date)}</time><span>约 {post.readingMinutes} 分钟阅读</span><span id="leancloud-page-views-container" data-counter-path={post.counterPath}>阅读 <span id="leancloud-page-views">—</span> 次</span></div></header>
    <div class="article-layout"><article class="article-content" data-pagefind-body data-pagefind-meta={`title:${post.title}`} set:html={post.html}></article>{post.headings.length > 0 && <aside class="article-toc" aria-label="文章目录"><details><summary>本文目录</summary><nav>{post.headings.map(heading=><a class:list={[{'toc-sub':heading.level===3}]} href={`#${heading.id}`}>{heading.text}</a>)}</nav></details></aside>}</div>
    {post.tags.length > 0 && <div class="tags">{post.tags.map(tag=><a href={taxonomyUrl('tags',tag)}>#{tag}</a>)}</div>}
    {post.course && <section class="series-navigation"><a class="text-link" href={`/courses/${post.course}/`}>返回「{post.courseName}」课程目录 →</a><div class="post-grid">{previousCoursePost && <div><p class="eyebrow">上一篇课程笔记</p><a href={previousCoursePost.url}>{previousCoursePost.title}</a></div>}{nextCoursePost && <div><p class="eyebrow">下一篇课程笔记</p><a href={nextCoursePost.url}>{nextCoursePost.title}</a></div>}</div></section>}
    {post.series && <section class="series-navigation"><a class="text-link" href={`/series/${seriesSlug(post.series)}/`}>查看「{post.series}」完整目录 →</a><div class="post-grid">{previous && <div><p class="eyebrow">上一篇</p><a href={previous.url}>{previous.title}</a></div>}{next && <div><p class="eyebrow">下一篇</p><a href={next.url}>{next.title}</a></div>}</div></section>}
    <section class="comments" aria-label="文章评论"><h2>评论</h2><script is:inline src="https://utteranc.es/client.js" repo="SpriCoder/spricoder-blog-comment" issue-term={post.counterPath !== post.url ? encodeURI(post.counterPath) : 'pathname'} theme="preferred-color-scheme" crossorigin="anonymous" async></script></section>
  </div> : <div class="container"><header class="page-header"><h1>{listingTitle}</h1><p>{taxonomy ? `${labels.length} 个${taxonomy === 'tags' ? '标签' : '分类'}` : `${archive?.totalItems ?? selected.length} 篇文章`}{archive && <span> · 第 {archive.currentPage} / {archive.totalPages} 页</span>}</p><div class="archive-nav"><a href="/archives/">全部文章</a><a href="/categories/">按分类</a><a href="/tags/">按标签</a></div></header>{taxonomy ? <div class="tags taxonomy-tags">{labels.map(label=><a href={taxonomyUrl(taxonomy,label)}>{label} <span>{posts.filter(item=>item[taxonomy].includes(label)).length}</span></a>)}</div> : <ul class="archive-list">{selected.map(item=><li><time datetime={item.date}>{dateLabel(item.date)}</time><a href={item.url}>{item.title}</a></li>)}</ul>}{archive && <ArchivePagination currentPage={archive.currentPage} totalPages={archive.totalPages} baseUrl={archive.baseUrl} />}</div>}
</SiteLayout>
<script>
  const content = document.querySelector('.article-content');
  const toc = document.querySelector('.article-toc details') as HTMLDetailsElement | null;
  if (toc) toc.open = window.matchMedia('(min-width: 961px)').matches;
  const firstHeading = content?.querySelector('h1:first-child');
  if (firstHeading?.textContent?.trim() === document.querySelector('.article-header h1')?.textContent?.trim()) (firstHeading as HTMLElement).hidden = true;
  const diagrams = document.querySelectorAll('pre.mermaid, code.mermaid, code.language-mermaid, figure.highlight.mermaid');
  if (diagrams.length) {
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default' });
    const nodes: HTMLElement[] = [];
    diagrams.forEach(node => { const pre = document.createElement('pre'); pre.className = 'mermaid'; pre.textContent = node.querySelector('td.code pre')?.textContent || node.textContent; (node.tagName === 'CODE' && node.parentElement?.tagName === 'PRE' ? node.parentElement : node).replaceWith(pre); nodes.push(pre); });
    await mermaid.run({ nodes });
  }
</script>
