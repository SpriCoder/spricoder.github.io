{
  "name": "spricoder-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/sync-content.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/sync-content.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist && node scripts/postbuild.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "verify": "python3 scripts/verify-migration.py",
    "verify:taxonomy": "node scripts/verify-taxonomy.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "gray-matter": "4.0.3",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mathjax3": "5.2.0",
    "mermaid": "12.2.0",
    "pagefind": "1.5.2"
  }
}
